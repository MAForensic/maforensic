{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/capsule-v1.schema.json",
  "title": "MASForensics Capability Capsule Document V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capsules"
  ],
  "properties": {
    "schema_version": {
      "const": "capsule-v1"
    },
    "capsule_defaults": {
      "type": "object"
    },
    "capsules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capsule"
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "type"
      ],
      "properties": {
        "port": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "failure_modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_codes",
        "output_conditions"
      ],
      "properties": {
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "output_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capsule_id",
        "tool_name",
        "name",
        "version",
        "origin_profile",
        "status",
        "maturity",
        "capsule_type",
        "capability_layer",
        "short_description",
        "executor_ref",
        "consumes",
        "produces",
        "applicable_to",
        "not_applicable_to",
        "underlying_dependencies",
        "failure_modes",
        "failure_semantics",
        "provenance_policy",
        "runtime_limits",
        "evolution",
        "composition"
      ],
      "properties": {
        "capsule_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)+$"
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "origin_profile": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "type": "string",
          "minLength": 1
        },
        "capsule_type": {
          "enum": [
            "primitive_capsule",
            "artifact_capsule",
            "workflow_capsule",
            "application_capsule",
            "analysis_capsule",
            "growth_capsule"
          ]
        },
        "capability_layer": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string",
          "minLength": 1
        },
        "executor_ref": {
          "type": "string",
          "pattern": "^existing_tool_registry:[A-Za-z0-9_]+$"
        },
        "consumes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "produces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "applicable_to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "not_applicable_to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "underlying_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "failure_modes": {
          "$ref": "#/$defs/failure_modes"
        },
        "failure_semantics": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance_policy": {
          "type": "object"
        },
        "runtime_limits": {
          "type": "object"
        },
        "evolution": {
          "type": "object"
        },
        "composition": {
          "type": "object"
        }
      }
    }
  }
}
